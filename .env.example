# Production configuration for docker-compose.yml.
#
#   cp .env.example .env      # .env is git-ignored; never commit it
#
# EVERY value below is a placeholder -- there is no usable secret in this file. The settings
# (uadas_api.settings.prod) refuse to start on a weak key, a placeholder-looking storage secret,
# an http:// public URL or a missing statement, so an unedited copy fails closed instead of
# running. Generate secrets with:   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Documentation of each variable (defaults, limits, what it guards): apps/api/README.md,
# "Environment variables". This file lists every variable the compose stack reads.
#
# Compose reads this file two ways: as `env_file` (passed to the containers, verbatim -- no
# quotes, no inline comments, no `export`) and for ${...} interpolation in docker-compose.yml.

# --- PostgreSQL (the postgres service creates the role and database from these) -------------
POSTGRES_USER=uadas
POSTGRES_PASSWORD=CHANGE_ME_postgres_password_alphanumeric_only
POSTGRES_DB=uadas
# Must repeat the three values above (compose cannot compute it). The password goes into a URL:
# use letters and digits only, or percent-encode it.
DATABASE_URL=postgres://uadas:CHANGE_ME_postgres_password_alphanumeric_only@postgres:5432/uadas

# --- Redis (cache on database 0; the job queue is moved to database 1 automatically) -------
REDIS_PASSWORD=CHANGE_ME_redis_password_alphanumeric_only
# Must repeat REDIS_PASSWORD (letters and digits only, or percent-encoded).
REDIS_URL=redis://:CHANGE_ME_redis_password_alphanumeric_only@redis:6379/0

# --- Django ---------------------------------------------------------------------------------
# At least 50 random characters; must not start with "django-insecure-".
DJANGO_SECRET_KEY=CHANGE_ME_at_least_50_random_characters
# The public host name(s) the API is served under; "*" is refused. The container health probe
# sends the first entry as its Host header.
DJANGO_ALLOWED_HOSTS=api.example.com
# Reverse proxy (see "Reverse proxy" below): TLS terminates there, so Django must not redirect to
# https itself and must trust the proxy's X-Forwarded-Proto. Only correct while the api port stays
# bound to 127.0.0.1 and the proxy sets and strips that header.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_PROXY_SSL_HEADER=true
# How many proxies YOU control in front of the app (allauth's per-IP rate limits read the client
# address from X-Forwarded-For): 1 for a single reverse proxy, never more than the truth.
DJANGO_TRUSTED_PROXY_COUNT=1
# The browser origin(s) of the web app, as https://host. Leave both empty for a same-origin deployment.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
# The SPA's address (https only); verification and password-reset emails link to it.
FRONTEND_BASE_URL=https://app.example.com
# Core log level (INFO, WARNING, ...); DEBUG is refused in production.
UADAS_CORE_LOG_LEVEL=INFO

# --- Email (required: sign-up cannot complete without mail) -----------------------------------
DEFAULT_FROM_EMAIL=UADAS <no-reply@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
# Leave both empty for an unauthenticated relay.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Object storage (an https S3-compatible store; NOT bundled, see docker-compose.yml) -------
STORAGE_BUCKET=CHANGE_ME-bucket-name
STORAGE_ENDPOINT_URL=https://objects.example.com
# Real credentials: prod refuses short (< 24 characters), low-variety or placeholder-looking
# secrets (changeme, example, minioadmin ...) and a secret equal to the key id.
STORAGE_ACCESS_KEY_ID=CHANGE_ME_access_key_id
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME_secret_access_key_at_least_24_chars
STORAGE_REGION=us-east-1
# auto | path | virtual   (MinIO needs path)
STORAGE_ADDRESSING=auto
# aes256 = server-side encryption on every write (required in prod). For a store that encrypts at
# rest by default and rejects the header, set STORAGE_SSE=none AND STORAGE_ENCRYPTION_ACKNOWLEDGED=1.
STORAGE_SSE=aes256
#STORAGE_ENCRYPTION_ACKNOWLEDGED=1

# --- Per-tenant quotas: prod demands ALL FOUR limits, or an explicit "unlimited" ----------------
# Rows an organization may hold; megabytes of uploaded originals; background-job minutes per
# month; assistant tokens per month.
QUOTA_MAX_ROWS=5000000
QUOTA_MAX_STORAGE_MB=10240
QUOTA_MAX_JOB_MINUTES=600
QUOTA_MAX_LLM_TOKENS=2000000
# ... or delete the four lines above and say unlimited is intended:
#QUOTA_UNLIMITED_ACKNOWLEDGED=true

# --- Parser sandbox -------------------------------------------------------------------------
# docker-compose.yml sets SANDBOX_ISOLATION_ACKNOWLEDGED=container and defaults
# SANDBOX_NETWORK_ISOLATION to `unshare` (the child isolates its own network namespace; verified
# by the code). Override only with a reason -- unshare | container | none-acknowledged; the trade-offs
# are in the header of docker-compose.yml and apps/api/README.md.
#SANDBOX_NETWORK_ISOLATION=unshare
# Other limits (wall/CPU seconds, memory, input/output size, rows/columns, zip-bomb budget):
# SANDBOX_* and JOBS_* in apps/api/README.md; the defaults are safe.

# --- AI assistant (optional: unset = the endpoint answers 503) -------------------------------------
#ASSISTANT_PROVIDER=anthropic
#ASSISTANT_API_KEY=
#ASSISTANT_MODEL=

# --- "Sign in with ..." (optional; each pair is both-or-neither) -------------------------------------
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# --- Reverse proxy (not part of the compose file) ---------------------------------------------------
# Terminate TLS on the host and proxy to 127.0.0.1:8000. The proxy must: set X-Forwarded-Proto and
# X-Forwarded-For (and strip any client-supplied copy), cap the request body (for example nginx
# `client_max_body_size 110m;` -- above SANDBOX_MAX_INPUT_MB, which Django enforces while streaming),
# and NOT buffer or compress text/event-stream (the job-progress stream; keep read timeout > 15 s).
