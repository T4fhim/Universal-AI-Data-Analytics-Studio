  "data": {
    "bar": [
      {
        "marker": {
          "line": {
            "width": 0
          }
        }
      }
    ],
    "histogram": [
      {
        "marker": {
          "line": {
            "width": 0
          }
        }
      }
    ],
    "scatter": [
      {
        "line": {
          "width": 1
        },
        "marker": {
          "size": 5
        }
      }
    ],
    "scatterpolar": [
      {
        "line": {
          "width": 1
        }
      }
    ],
    "box": [
      {
        "line": {
          "width": 1
        }
      }
    ],
    "funnel": [
      {
        "marker": {
          "line": {
            "width": 0
          }
        }
      }
    ],
    "pie": [
      {
        "marker": {
          "line": {
            "color": "#111111",
            "width": 2
          }
        },
        "textposition": "outside",
        "automargin": true,
        "textfont": {
          "color": "#e5e6e7"
        }
      }
    ],
    "treemap": [
      {
        "marker": {
          "line": {
            "color": "#111111",
            "width": 1
          }
        },
        "textfont": {
          "color": "#e5e6e7"
        }
      }
    ],
    "heatmap": [
      {
        "colorbar": {
          "outlinewidth": 0,
          "thickness": 8,
          "tickfont": {
            "family": "\"JetBrains Mono\", \"Cascadia Mono\", Consolas, \"Liberation Mono\", monospace",
            "size": 11,
            "color": "#d4d5d7"
          }
        }
      }
    ],
    "waterfall": [
      {
        "increasing": {
          "marker": {
            "color": "#279f27"
          }
        },
        "decreasing": {
          "marker": {
            "color": "#d52d21"
          }
        },
        "totals": {
          "marker": {
            "color": "#2376b0"
          }
        },
        "connector": {
          "line": {
            "color": "#707073",
            "width": 1
          }
        }
      }
    ]
