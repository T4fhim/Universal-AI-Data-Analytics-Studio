# import-linter contract - the machine-checked half of the desktop->web transition.
#
# The Qt-free carve-out packages now live under uadas_core (Phase 1.1). No module in
# uadas_core may import a GUI toolkit or a web framework. Run: lint-imports.
# Enforced in CI's lint job (see .github/workflows/ci.yml).
#
# Phase 3.1 adds the Django backend `uadas_api` (apps/api) as a second root package.
# It is not on the default import path, so run with PYTHONPATH=apps/api (CI's lint job
# sets it) or `pip install -e apps/api`; without that, lint-imports cannot find it.

[importlinter]
root_packages =
    uadas_core
    uadas_api
include_external_packages = True

[importlinter:contract:uadas-core-qt-and-framework-free]
name = uadas_core must not import PySide6/PyQt/Django
type = forbidden
source_modules =
    uadas_core
forbidden_modules =
    PySide6
    PyQt5
    PyQt6
    django
allow_indirect_imports = False

# Phase 1.7: uadas_core.provenance is a read-only *view* over the orchestrator's
# AnalysisLog set (it imports uadas_core.services / .analysis / .core). NOTHING
# else in uadas_core may import it back -- keep the dependency one-directional so
# the reshape layer stays swappable. Every non-provenance subpackage is listed
# (a bare `uadas_core` source would flag provenance importing its own submodules).
[importlinter:contract:provenance-is-a-leaf]
name = no uadas_core subpackage except provenance itself may import uadas_core.provenance
type = forbidden
source_modules =
    uadas_core.a11y
    uadas_core.actions
    uadas_core.ai
    uadas_core.analysis
    uadas_core.bootstrap
    uadas_core.cleaning
    uadas_core.command_stack
    uadas_core.core
    uadas_core.data_table
    uadas_core.database
    uadas_core.forecasting
    uadas_core.help
    uadas_core.jobs
    uadas_core.models
    uadas_core.persistence
    uadas_core.plugins
    uadas_core.readers
    uadas_core.reports
    uadas_core.results
    uadas_core.services
    uadas_core.theme
    uadas_core.visualization
forbidden_modules =
    uadas_core.provenance
allow_indirect_imports = False

# Phase 2.3: the uadas_core dependency stack, top (imported by nobody) to
# bottom (imports nothing else in uadas_core). A module may import any layer
# below it, never one above. `|` marks independent siblings -- they may not
# import each other either. Validated by dry run against the post-2.2 tree;
# see plans/phase-2-3-plan.md for why the two ignores below are the only ones.
[importlinter:contract:uadas-core-layers]
name = uadas_core subpackages form a strict dependency stack
type = layers
layers =
    uadas_core.bootstrap | uadas_core.provenance | uadas_core.command_stack
    uadas_core.persistence | uadas_core.actions
    uadas_core.services
    uadas_core.ai
    uadas_core.plugins
    uadas_core.results
    uadas_core.visualization
    uadas_core.analysis
    uadas_core.cleaning | uadas_core.forecasting | uadas_core.database | uadas_core.reports | uadas_core.jobs
    uadas_core.readers | uadas_core.a11y
    uadas_core.models | uadas_core.theme | uadas_core.help | uadas_core.data_table
    uadas_core.core
ignore_imports =
    # (1) The last strand of the old services<->ai cycle (Phase 1 diagnosis
    # D1). AssistantService takes WorkspaceService purely as a constructor
    # annotation (assistant_service.py:150,178) -- no runtime use -- but
    # import-linter counts TYPE_CHECKING imports, so guarding it would not
    # help. Remove when the annotation becomes a Protocol (2.7 / Phase 3).
    uadas_core.ai.assistant_service -> uadas_core.services.workspace_service
    # (2) The core<->models cycle Phase 2.2 left behind: application_state
    # annotates with Dataset/Project/Visualization under TYPE_CHECKING while
    # models.project raises core.exceptions.ServiceError. Annotation-only, so
    # no runtime cycle exists. Remove if ApplicationState moves above core or
    # the annotation becomes a Protocol.
    uadas_core.core.application_state -> uadas_core.models

# Phase 3.1: dependency direction between the core and the web backend. The API
# depends on the core, never the other way round -- the core stays a framework-free
# library. (Contract 1 above already forbids django; this one forbids the backend
# package itself, which would otherwise be a legal import for a stray module.)
[importlinter:contract:core-does-not-import-api]
name = uadas_core must not import uadas_api
type = forbidden
source_modules =
    uadas_core
forbidden_modules =
    uadas_api
allow_indirect_imports = False

# Phase 3.1 (plans/phase-3-readiness.md ruling 1): the API reaches the core through
# its services, not through the two subpackages that are unsafe in a multi-tenant
# server -- `plugins` (arbitrary third-party code; hard-off in server mode) and
# `jobs` (the process-global desktop job runner; the API uses django.tasks instead).
# allow_indirect_imports stays False on purpose: if a core service the API legitimately
# imports starts importing `plugins` or `jobs` itself, this contract fails and that
# edge must be re-examined, not silently permitted. Remove an entry only by a
# reviewed change to the readiness ruling.
[importlinter:contract:api-avoids-plugins-and-jobs]
name = uadas_api must not import uadas_core.plugins or uadas_core.jobs
type = forbidden
source_modules =
    uadas_api
forbidden_modules =
    uadas_core.plugins
    uadas_core.jobs
allow_indirect_imports = False
