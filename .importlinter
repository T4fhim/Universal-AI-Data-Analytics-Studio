# import-linter contract - the machine-checked half of the desktop->web transition.
#
# The Qt-free carve-out packages now live under uadas_core (Phase 1.1). No module in
# uadas_core may import a GUI toolkit or a web framework. Run: lint-imports.
# Enforced in CI's lint job (see .github/workflows/ci.yml).

[importlinter]
root_packages =
    uadas_core
include_external_packages = True

[importlinter:contract:uadas-core-qt-and-framework-free]
name = uadas_core must not import PySide6/PyQt/Django
type = forbidden
source_modules =
    uadas_core
forbidden_modules =
    PySide6
    PyQt5
    PyQt6
    django
allow_indirect_imports = False
