{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\quality-check.ps1\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "timeout": 900,
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$stdin = [Console]::In.ReadToEnd(); $event = $stdin | ConvertFrom-Json; if ($event.tool_input.command -match 'git\\s+commit(?![\\w-])') { & '$CLAUDE_PROJECT_DIR\\.claude\\hooks\\pre-commit-check.ps1'; exit $LASTEXITCODE }; exit 0\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\protect-files.ps1\""
          }
        ]
      }
    ]
  }
}
