/* File: resources/styles/light.qss */
/*
Light theme for Universal AI Data Analytics Studio.

This file deliberately mirrors dark.qss's selector structure exactly
— the same widgets, the same object names, in the same order — with
only the color values changed. This is intentional: if a widget is
styled in one theme file but not the other, that widget would flash
unstyled (falling back to Qt's default appearance) when the user
switches themes, and keeping the two files structurally identical
makes that kind of drift immediately visible on inspection rather than
something that only surfaces when a user happens to switch themes and
notices an inconsistency.
*/

* {
    font-family: "Segoe UI", "Inter", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #f5f5f7;
    color: #1e1f24;
}

QMenuBar {
    background-color: #ffffff;
    color: #1e1f24;
    border-bottom: 1px solid #d8d8dc;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #e4e4e8;
}

QMenu {
    background-color: #ffffff;
    color: #1e1f24;
    border: 1px solid #d8d8dc;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #3a5fc4;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #d8d8dc;
    margin: 4px 8px;
}

QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #d8d8dc;
    padding: 4px;
    spacing: 4px;
}

QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px;
    color: #1e1f24;
}

QToolButton:hover {
    background-color: #e4e4e8;
}

QToolButton:pressed {
    background-color: #3a5fc4;
    color: #ffffff;
}

QStatusBar {
    background-color: #ffffff;
    color: #5a5b62;
    border-top: 1px solid #d8d8dc;
}

QDockWidget {
    color: #1e1f24;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #ffffff;
    padding: 6px 8px;
    border-bottom: 1px solid #d8d8dc;
}

QWidget#welcomeWidget {
    background-color: #f5f5f7;
}

QLabel {
    color: #1e1f24;
    background: transparent;
}

QLabel#welcomeTitle {
    font-size: 24px;
    font-weight: 600;
    color: #101012;
}

QLabel#welcomeSubtitle {
    font-size: 14px;
    color: #5a5b62;
}

QPushButton {
    background-color: #3a5fc4;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #2a4fb4;
}

QPushButton:pressed {
    background-color: #1a3fa4;
}

QPushButton:disabled {
    background-color: #e4e4e8;
    color: #a0a1a8;
}

QPushButton#secondaryButton {
    background-color: #ffffff;
    color: #1e1f24;
    border: 1px solid #d8d8dc;
}

QPushButton#secondaryButton:hover {
    background-color: #e4e4e8;
}

QListWidget, QTreeWidget, QTreeView {
    background-color: #ffffff;
    color: #1e1f24;
    border: 1px solid #d8d8dc;
    border-radius: 4px;
    outline: none;
}

QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #3a5fc4;
    color: #ffffff;
}

QLineEdit, QSpinBox, QComboBox, QPlainTextEdit, QTextEdit {
    background-color: #ffffff;
    color: #1e1f24;
    border: 1px solid #d8d8dc;
    border-radius: 4px;
    padding: 4px 8px;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid #3a5fc4;
}

QCheckBox {
    color: #1e1f24;
}

QScrollBar:vertical {
    background: #f5f5f7;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #d8d8dc;
    border-radius: 6px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #c0c0c6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QTabWidget::pane {
    border: 1px solid #d8d8dc;
    background-color: #f5f5f7;
}

QTabBar::tab {
    background-color: #ffffff;
    color: #5a5b62;
    padding: 8px 16px;
    border: none;
}

QTabBar::tab:selected {
    background-color: #f5f5f7;
    color: #101012;
    border-bottom: 2px solid #3a5fc4;
}
