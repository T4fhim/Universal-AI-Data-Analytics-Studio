/* File: resources/styles/dark.qss */
/*
Dark theme for Universal AI Data Analytics Studio.

Loaded by src/ui/theme_manager.py and applied to the QApplication
instance as a whole (via setStyleSheet), rather than per-widget, so
that every widget constructed after theme switching inherits the
active theme automatically without each widget needing its own
styling logic.

Color roles used throughout, kept as literal hex values rather than Qt
palette roles: PySide6's QSS support does not resolve Qt palette
color-role names the way native widget styling does, so literal values
are the reliable approach here. If a design-token system (a shared set
of named colors) becomes worth the complexity, both this file and
light.qss should be regenerated from it together, so the two can never
drift into inconsistent naming — that is future work, not something to
half-do here now.
*/

* {
    font-family: "Segoe UI", "Inter", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #1e1f24;
    color: #e6e6e8;
}

QMenuBar {
    background-color: #26272e;
    color: #e6e6e8;
    border-bottom: 1px solid #35363e;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #3a3b44;
}

QMenu {
    background-color: #26272e;
    color: #e6e6e8;
    border: 1px solid #35363e;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #3a5fc4;
}

QMenu::separator {
    height: 1px;
    background-color: #35363e;
    margin: 4px 8px;
}

QToolBar {
    background-color: #26272e;
    border-bottom: 1px solid #35363e;
    padding: 4px;
    spacing: 4px;
}

QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px;
    color: #e6e6e8;
}

QToolButton:hover {
    background-color: #3a3b44;
}

QToolButton:pressed {
    background-color: #3a5fc4;
}

QStatusBar {
    background-color: #26272e;
    color: #a0a1a8;
    border-top: 1px solid #35363e;
}

QDockWidget {
    color: #e6e6e8;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #26272e;
    padding: 6px 8px;
    border-bottom: 1px solid #35363e;
}

QWidget#welcomeWidget {
    background-color: #1e1f24;
}

QLabel {
    color: #e6e6e8;
    background: transparent;
}

QLabel#welcomeTitle {
    font-size: 24px;
    font-weight: 600;
    color: #ffffff;
}

QLabel#welcomeSubtitle {
    font-size: 14px;
    color: #a0a1a8;
}

QPushButton {
    background-color: #3a5fc4;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #4a6fd4;
}

QPushButton:pressed {
    background-color: #2a4fb4;
}

QPushButton:disabled {
    background-color: #35363e;
    color: #6a6b72;
}

QPushButton#secondaryButton {
    background-color: #26272e;
    color: #e6e6e8;
    border: 1px solid #35363e;
}

QPushButton#secondaryButton:hover {
    background-color: #3a3b44;
}

QListWidget, QTreeWidget, QTreeView {
    background-color: #26272e;
    color: #e6e6e8;
    border: 1px solid #35363e;
    border-radius: 4px;
    outline: none;
}

QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #3a5fc4;
    color: #ffffff;
}

QLineEdit, QSpinBox, QComboBox, QPlainTextEdit, QTextEdit {
    background-color: #26272e;
    color: #e6e6e8;
    border: 1px solid #35363e;
    border-radius: 4px;
    padding: 4px 8px;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid #3a5fc4;
}

QCheckBox {
    color: #e6e6e8;
}

QScrollBar:vertical {
    background: #1e1f24;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #3a3b44;
    border-radius: 6px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #4a4b54;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QTabWidget::pane {
    border: 1px solid #35363e;
    background-color: #1e1f24;
}

QTabBar::tab {
    background-color: #26272e;
    color: #a0a1a8;
    padding: 8px 16px;
    border: none;
}

QTabBar::tab:selected {
    background-color: #1e1f24;
    color: #ffffff;
    border-bottom: 2px solid #3a5fc4;
}
